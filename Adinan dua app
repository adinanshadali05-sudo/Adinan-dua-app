function $(i){return document.getElementById(i)}
function loadSet(){var d={name:"Adinan",notif:true,tm:"05:00",te:"17:00",theme:"auto",size:"m",vib:true};try{var v=JSON.parse(localStorage.getItem("adn_set")||"{}");for(var k in v)d[k]=v[k]}catch(e){}return d}
var SET=loadSet();
function saveSet(){try{localStorage.setItem("adn_set",JSON.stringify(SET))}catch(e){}}
var S=new Date().getHours()<15?"morning":"evening",ST={},CARDS=[],C=119.4;
var LN=(window.Capacitor&&window.Capacitor.Plugins&&window.Capacitor.Plugins.LocalNotifications)||null;
function key(){var d=new Date();return "adhkar:"+d.getFullYear()+"-"+(d.getMonth()+1)+"-"+d.getDate()+":"+S}
function load(){ST={};try{var v=localStorage.getItem(key());if(v)ST=JSON.parse(v)||{}}catch(e){}}
function save(){try{localStorage.setItem(key(),JSON.stringify(ST))}catch(e){}}
function items(){return COMMON.filter(function(x){return !x.only||x.only===S})}
function left(it){return ST[it.id]===undefined?it.n:ST[it.id]}
function theme(){var eff=SET.theme==="auto"?(S==="evening"?"dark":"light"):SET.theme,r=document.documentElement;r.setAttribute("data-eff",eff);r.setAttribute("data-size",SET.size);var m=document.querySelector("meta[name=theme-color]");if(m)m.content=eff==="dark"?"#0C1A26":"#EEF3F1"}
function head(){
  $("hello").textContent="Assalaamu ‘alaykum, "+(SET.name||"Adinan");
  var d=new Date().toLocaleDateString("en-GB",{weekday:"long",day:"numeric",month:"long"});
  $("sub").textContent=(S==="morning"?"Duaa’ii ganamaa":"Duaa’ii galgalaa")+" · "+d;
  ["morning","evening"].forEach(function(s){$("t-"+s).setAttribute("aria-selected",String(s===S))});
}
function pulse(b){b.classList.add("pop");setTimeout(function(){b.classList.remove("pop")},120)}
function build(){
  var list=$("list");list.innerHTML="";CARDS=[];
  items().forEach(function(it){
    var b=document.createElement("button");b.className="card";
    b.innerHTML='<div class="ch"><span class="ct"></span><span class="cn"></span></div><p class="ar" dir="rtl"></p><div class="cf"><span class="hint"></span><span class="ring"><svg viewBox="0 0 44 44" aria-hidden="true"><circle class="bg" cx="22" cy="22" r="19"/><circle class="fg" cx="22" cy="22" r="19"/></svg><b></b></span></div>';
    b.querySelector(".ct").textContent=it.t;
    b.querySelector(".cn").textContent="× "+it.n;
    b.querySelector(".ar").textContent=it.a||(S==="morning"?it.m:it.e);
    b.onclick=function(){var l=left(it);if(l>0){ST[it.id]=l-1;save();pulse(b);if(SET.vib&&navigator.vibrate)try{navigator.vibrate(l-1===0?[40,40,40]:12)}catch(e){}update()}};
    list.appendChild(b);CARDS.push({it:it,el:b});
  });
  update();
}
function update(){
  var sum=0,done=0;
  CARDS.forEach(function(c){
    var it=c.it,l=left(it),p=(it.n-l)/it.n,e=c.el;sum+=p;if(l===0)done++;
    e.classList.toggle("done",l===0);
    e.querySelector(".fg").style.strokeDashoffset=C*(1-p);
    e.querySelector(".ring b").textContent=l===0?"✓":l;
    e.querySelector(".hint").textContent=l===0?"Xumurameera":(l===it.n?"Tuqaa lakkaa’i":(it.n-l)+" / "+it.n+" jedhameera");
    e.setAttribute("aria-label",it.t+", hafe "+l);
  });
  var all=done===CARDS.length,pct=all?100:Math.min(99,Math.round(sum/CARDS.length*100));
  $("pct").textContent=pct+"%";$("fill").style.width=pct+"%";
  $("cnt").textContent=done+" / "+CARDS.length+" duaa’ii xumurameera";
  if(all&&!ST._c){ST._c=1;save();setTimeout(showDone,350)}
}
function openOv(id){$(id).classList.add("on")}
function closeOv(id){$(id).classList.remove("on")}
function showDone(){
  $("dt").textContent="Baga gammaddan, "+(SET.name||"Adinan")+"!";
  $("dm").textContent=(S==="morning"?"Duaa’ii ganamaa":"Duaa’ii galgalaa")+" guutummaatti xumurteetta. Maashaa’Allaah!";
  openOv("done");
}
function setTab(s){S=s;load();theme();head();build()}
function showPhoto(){
  var d=null;try{d=localStorage.getItem("photo")}catch(e){}
  var a=$("ava");
  if(d){a.style.backgroundImage="url("+d+")";a.textContent=""}else{a.style.backgroundImage="";a.innerHTML="Suura<br>kaa’i"}
}
function sched(){
  var msg=$("nmsg");
  if(!LN){msg.textContent="Yaadachiisni app dhugaa (APK) keessatti qofa hojjata.";return}
  if(!SET.notif){LN.cancel({notifications:[{id:1},{id:2}]}).then(function(){msg.textContent="Yaadachiisni dhaabbateera."}).catch(function(){});return}
  LN.requestPermissions().then(function(p){
    if(p.display!=="granted"){msg.textContent="Hayyama notification kennaa (Settings > Apps > Adinan Dua App > Notifications).";return}
    var a=SET.tm.split(":"),b=SET.te.split(":");
    return LN.cancel({notifications:[{id:1},{id:2}]}).then(function(){
      return LN.schedule({notifications:[
        {id:1,title:"Adinan Dua App",body:"Yeroon duaa’ii ganamaa ga’eera 🌅",schedule:{on:{hour:+a[0],minute:+a[1]},allowWhileIdle:true}},
        {id:2,title:"Adinan Dua App",body:"Yeroon duaa’ii galgalaa ga’eera 🌙",schedule:{on:{hour:+b[0],minute:+b[1]},allowWhileIdle:true}}]});
    }).then(function(){msg.textContent="Yaadachiisni kaa’ameera: "+SET.tm+" fi "+SET.te+" (guyyaa guyyaan)."});
  }).catch(function(e){msg.textContent="Dogoggora: "+e});
}
function fill(){$("nm").value=SET.name;$("nt").checked=!!SET.notif;$("tm").value=SET.tm;$("te").value=SET.te;$("th").value=SET.theme;$("sz").value=SET.size;$("vb").checked=!!SET.vib}
$("t-morning").onclick=function(){setTab("morning")};
$("t-evening").onclick=function(){setTab("evening")};
$("ava").onclick=function(){$("pf").click()};
$("chg").onclick=function(){$("pf").click()};
$("rm").onclick=function(){try{localStorage.removeItem("photo")}catch(e){}showPhoto()};
$("pf").onchange=function(ev){
  var f=ev.target.files&&ev.target.files[0];if(!f)return;
  var img=new Image(),u=URL.createObjectURL(f);
  img.onload=function(){
    var c=document.createElement("canvas"),z=240;c.width=z;c.height=z;
    var m=Math.min(img.width,img.height);
    c.getContext("2d").drawImage(img,(img.width-m)/2,(img.height-m)/2,m,m,0,0,z,z);
    try{localStorage.setItem("photo",c.toDataURL("image/jpeg",0.85))}catch(e){}
    URL.revokeObjectURL(u);showPhoto();
  };
  img.src=u;ev.target.value="";
};
$("bset").onclick=function(){fill();$("nmsg").textContent="";openOv("set")};
$("bhelp").onclick=function(){openOv("help")};
$("cl").onclick=function(){closeOv("set")};
$("hc").onclick=function(){closeOv("help")};
$("dc").onclick=function(){closeOv("done")};
["set","help","done"].forEach(function(id){$(id).onclick=function(e){if(e.target===$(id))closeOv(id)}});
$("nm").oninput=function(){SET.name=$("nm").value.trim()||"Adinan";saveSet();head()};
$("th").onchange=function(){SET.theme=$("th").value;saveSet();theme()};
$("sz").onchange=function(){SET.size=$("sz").value;saveSet();theme()};
$("vb").onchange=function(){SET.vib=$("vb").checked;saveSet()};
$("nt").onchange=function(){SET.notif=$("nt").checked;saveSet();sched()};
$("sv").onclick=function(){SET.notif=$("nt").checked;SET.tm=$("tm").value||"05:00";SET.te=$("te").value||"17:00";saveSet();sched()};
var rsArm=false;
$("rs").onclick=function(){
  if(!rsArm){rsArm=true;$("rs").textContent="Mirkaneessi: tuqaa";setTimeout(function(){rsArm=false;$("rs").textContent="Galmee har’aa haaromsi"},4000);return}
  rsArm=false;$("rs").textContent="Galmee har’aa haaromsi";ST={};save();build();closeOv("set");
};
theme();head();showPhoto();load();build();
var first=false;try{first=!localStorage.getItem("adn_init");localStorage.setItem("adn_init","1")}catch(e){}
if(LN&&first)sched();
</script>
</body>
